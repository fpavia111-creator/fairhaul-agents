{
  "suite": "elnath-of-margins",
  "root": "..",
  "data_note": "Fictional orders and freight costs in ../fixtures. No model is called.",
  "cases": [
    {"id": "totals", "tool": "elnath_margins", "args": {"orders": "fixtures/orders.csv", "costs": "fixtures/freight-costs.csv", "threshold": 1000}, "expect": {"equals": {"result.freight_cost": 2215.92, "result.freight_billed": 213, "result.recovery_pct": 9.6, "result.collect_but_we_paid": 210, "result.prepaid_add_not_billed": 88, "result.free_below_threshold": 213.52}}},
    {"id": "shared-shipment-split", "tool": "elnath_margins", "args": {"orders": "fixtures/orders.csv", "costs": "fixtures/freight-costs.csv"}, "expect": {"contains": ["\"order_id\":\"SO-6001\",\"customer\":\"Hill Country Home\",\"shipment_id\":\"S-901\",\"terms\":\"prepaid\",\"order_value\":1850,\"freight_billed\":0,\"freight_cost\":233.08"]}},
    {"id": "worst-customer", "tool": "elnath_margins", "args": {"orders": "fixtures/orders.csv", "costs": "fixtures/freight-costs.csv"}, "expect": {"equals": {"result.by_customer.0.customer": "Front Range Supply", "result.by_customer.0.gap": -1457.52}}},
    {"id": "thresholds", "tool": "elnath_margins", "args": {"orders": "fixtures/orders.csv", "costs": "fixtures/freight-costs.csv", "threshold": 1000, "alternatives": [2500]}, "expect": {"equals": {"result.scenarios.0.extra_recovery_estimate": 85.2, "result.scenarios.1.orders_paying": 4, "result.scenarios.1.extra_recovery_estimate": 175.79}}},
    {"id": "no-cost-flagged", "tool": "elnath_margins", "args": {"orders": "fixtures/orders.csv", "costs": "fixtures/freight-costs.csv"}, "expect": {"equals": {"result.with_cost": 9}, "contains": ["no_cost"]}},
    {"id": "draft", "tool": "elnath_draft_terms_change", "mode": "auto", "auto_actions": ["elnath_draft_terms_change"], "args": {"orders": "fixtures/orders.csv", "costs": "fixtures/freight-costs.csv", "threshold": 1000}, "expect": {"contains": ["terms_change", "Nothing was sent"]}},
    {"id": "apply-stays-a-click-in-auto", "tool": "elnath_request_apply", "mode": "auto", "args": {"draft": "fixtures/README.md", "draft_sha256": "0"}, "expect": {"status": "needs_approval"}},
    {"id": "never-bills", "tool": "ar_rebill_freight", "mode": "auto", "args": {}, "expect": {"status": "blocked"}}
  ]
}
