{
  "suite": "canopus-of-air",
  "root": "..",
  "data_note": "Fictional air invoices and rate sheet in ../fixtures. No model is called.",
  "cases": [
    {"id": "totals", "tool": "canopus_audit", "args": {"invoices": "fixtures/air-invoices.csv", "rates": "fixtures/rates.json"}, "expect": {"equals": {"result.shipments": 5, "result.billed": 6164.9, "result.disputable": 349, "result.with_findings": 4}}},
    {"id": "volumetric", "tool": "canopus_audit", "args": {"invoices": "fixtures/air-invoices.csv", "rates": "fixtures/rates.json"}, "expect": {"equals": {"result.items.1.volumetric_kg": 400, "result.items.1.chargeable_kg": 400, "result.items.1.disputable": 200}}},
    {"id": "every-finding", "tool": "canopus_audit", "args": {"invoices": "fixtures/air-invoices.csv", "rates": "fixtures/rates.json"}, "expect": {"contains": ["weight_over", "rate_over", "surcharge_over", "charge_not_on_rate_sheet"]}},
    {"id": "break-point-quote", "tool": "canopus_quote", "args": {"rates": "fixtures/rates.json", "forwarder": "Skyline Logistics", "origin": "FRA", "destination": "ORD", "actual_kg": 90, "volume_cbm": 0.3}, "expect": {"equals": {"result.air_freight.key": "+100", "result.air_freight.cost": 380}}},
    {"id": "minimum-quote", "tool": "canopus_quote", "args": {"rates": "fixtures/rates.json", "forwarder": "Skyline Logistics", "origin": "FRA", "destination": "ORD", "actual_kg": 10}, "expect": {"equals": {"result.air_freight.key": "minimum", "result.air_freight.cost": 85}}},
    {"id": "send-stays-a-click-in-auto", "tool": "canopus_request_send", "mode": "auto", "args": {"draft": "fixtures/README.md", "draft_sha256": "0"}, "expect": {"status": "needs_approval"}},
    {"id": "never-pays", "tool": "ap_pay_invoice", "mode": "auto", "args": {}, "expect": {"status": "blocked"}}
  ]
}
