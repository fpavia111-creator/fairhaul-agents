{
  "suite": "canopus-of-air",
  "root": "..",
  "data_note": "Fictional air invoices and rate sheet in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "canopus_audit",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json"
      },
      "expect": {
        "equals": {
          "result.shipments": 5,
          "result.billed": 6164.9,
          "result.disputable": 349,
          "result.with_findings": 4
        }
      }
    },
    {
      "id": "volumetric",
      "tool": "canopus_audit",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json"
      },
      "expect": {
        "equals": {
          "result.items.1.volumetric_kg": 400,
          "result.items.1.chargeable_kg": 400,
          "result.items.1.disputable": 200
        }
      }
    },
    {
      "id": "every-finding",
      "tool": "canopus_audit",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json"
      },
      "expect": {
        "contains": [
          "weight_over",
          "rate_over",
          "surcharge_over",
          "charge_not_on_rate_sheet"
        ]
      }
    },
    {
      "id": "break-point-quote",
      "tool": "canopus_quote",
      "args": {
        "rates": "fixtures/rates.json",
        "forwarder": "Skyline Logistics",
        "origin": "FRA",
        "destination": "ORD",
        "actual_kg": 90,
        "volume_cbm": 0.3
      },
      "expect": {
        "equals": {
          "result.air_freight.key": "+100",
          "result.air_freight.cost": 380
        }
      }
    },
    {
      "id": "minimum-quote",
      "tool": "canopus_quote",
      "args": {
        "rates": "fixtures/rates.json",
        "forwarder": "Skyline Logistics",
        "origin": "FRA",
        "destination": "ORD",
        "actual_kg": 10
      },
      "expect": {
        "equals": {
          "result.air_freight.key": "minimum",
          "result.air_freight.cost": 85
        }
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "canopus_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-pays",
      "tool": "ap_pay_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "canopus_audit",
      "args": {
        "invoices": "fixtures/intl/de/air-invoices.csv",
        "rates": "fixtures/rates.json"
      },
      "expect": {
        "equals": {
          "result.shipments": 5,
          "result.billed": 6164.9,
          "result.disputable": 349,
          "result.with_findings": 4
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "canopus_audit",
      "args": {
        "invoices": "fixtures/intl/ja/air-invoices.csv",
        "rates": "fixtures/rates.json"
      },
      "expect": {
        "equals": {
          "result.shipments": 5,
          "result.billed": 6164.9,
          "result.disputable": 349,
          "result.with_findings": 4
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "canopus_write_report",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json",
        "out_dir": "lodestar-out/evals/canopus_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "5 air waybill(s), 6164.9 billed: 4 with findings, 349 disputable",
          "rate_over 3, charge_not_on_rate_sheet 1, surcharge_over 1, weight_over 1"
        ]
      }
    },
    {
      "id": "draft-dispute-waits-for-a-person",
      "tool": "canopus_draft_dispute",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json",
        "forwarder": "Skyline Logistics",
        "out_dir": "lodestar-out/evals/canopus_draft_dispute"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-dispute-after-approval",
      "tool": "canopus_draft_dispute",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json",
        "forwarder": "Skyline Logistics",
        "out_dir": "lodestar-out/evals/canopus_draft_dispute"
      },
      "approve": "Pat Example",
      "expect": {
        "status": "executed",
        "equals": {
          "result.amount": 349,
          "result.open_markers": 3
        },
        "contains": [
          "dispute Skyline Logistics drafted for 349 with 3 open marker(s) ([TO CONFIRM Skyline Logistics billing contact], [TO CONFIRM your name and company], [ATTACH the rate sheet and the AWB with dimensions])"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "canopus_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "canopus_audit",
      "args": {
        "invoices": "../../outside.csv",
        "rates": "fixtures/rates.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "canopus_audit",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.shipments": 5,
          "result.billed": 6164.9,
          "result.disputable": 349,
          "result.with_findings": 4
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "canopus_audit",
      "args": {
        "rates": "fixtures/rates.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "invoices"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "canopus_draft_dispute",
      "args": {
        "invoices": "fixtures/air-invoices.csv",
        "rates": "fixtures/rates.json",
        "forwarder": "Skyline Logistics",
        "out_dir": "lodestar-out/evals/canopus_draft_dispute"
      },
      "mode": "review",
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    }
  ]
}
