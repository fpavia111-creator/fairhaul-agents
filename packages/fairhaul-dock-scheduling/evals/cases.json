{
  "suite": "fairhaul-dock-scheduling",
  "root": "..",
  "data_note": "Fictional dock, requests and past appointments in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "plan-totals",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18"
      },
      "expect": {
        "equals": {
          "result.requests": 10,
          "result.scheduled": 8,
          "result.no_slot": 2
        }
      }
    },
    {
      "id": "no-slot-reasons",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json"
      },
      "expect": {
        "contains": [
          "no door takes flatbed",
          "the dock closes before it could finish"
        ]
      }
    },
    {
      "id": "reefer-to-d4",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json"
      },
      "expect": {
        "contains": [
          "\"load_id\":\"PO-4406\",\"carrier\":\"Coastal Line Haul\",\"direction\":\"inbound\",\"door_type\":\"reefer\",\"pallets\":22,\"minutes\":59,\"window\":\"06:30-07:15\",\"door\":\"D4\",\"start\":\"07:00\""
        ]
      }
    },
    {
      "id": "review",
      "tool": "docks_review",
      "args": {
        "history": "fixtures/history.csv"
      },
      "expect": {
        "equals": {
          "result.appointments": 10,
          "result.on_time_pct": 70,
          "result.no_show": 1,
          "result.worst_hour.hour": "07:00",
          "result.by_carrier.0.carrier": "Summit Carriers"
        }
      }
    },
    {
      "id": "floor-takes-longer",
      "tool": "docks_review",
      "args": {
        "history": "fixtures/history.csv"
      },
      "expect": {
        "contains": [
          "floor 6.5 min/pallet"
        ]
      }
    },
    {
      "id": "bad-settings",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/README.md"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "publish-stays-a-click-in-auto",
      "tool": "docks_request_publish",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-books",
      "tool": "yms_book_appointment",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-plan-totals",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/intl/de/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18"
      },
      "expect": {
        "equals": {
          "result.requests": 10,
          "result.scheduled": 8,
          "result.no_slot": 2
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"plan-totals\"."
    },
    {
      "id": "intl-ja-plan-totals",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/intl/ja/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18"
      },
      "expect": {
        "equals": {
          "result.requests": 10,
          "result.scheduled": 8,
          "result.no_slot": 2
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"plan-totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "docks_write_report",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18",
        "out_dir": "fairhaul-out/evals/docks_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "2026-11-18: 8 of 10 appointment(s) placed on 4 door(s), 06:00-14:00, dock use 34%",
          "2 could not be placed"
        ]
      }
    },
    {
      "id": "draft-schedule-waits-for-a-person",
      "tool": "docks_draft_schedule",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18",
        "out_dir": "fairhaul-out/evals/docks_draft_schedule"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-schedule-after-approval",
      "tool": "docks_draft_schedule",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18",
        "out_dir": "fairhaul-out/evals/docks_draft_schedule"
      },
      "approve": "Pat Example",
      "expect": {
        "status": "executed",
        "equals": {
          "result.open_markers": 1
        },
        "contains": [
          "schedule 2026-11-18 drafted with 1 open marker(s) ([TO CONFIRM: carriers on this list])"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "docks_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "docks_plan",
      "args": {
        "requests": "../../outside.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.requests": 10,
          "result.scheduled": 8,
          "result.no_slot": 2
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "docks_plan",
      "args": {
        "dock": "fixtures/dock.json",
        "date": "2026-11-18"
      },
      "expect": {
        "status": "error",
        "contains": [
          "requests"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "docks_draft_schedule",
      "args": {
        "requests": "fixtures/requests.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18",
        "out_dir": "fairhaul-out/evals/docks_draft_schedule"
      },
      "mode": "review",
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "docks_plan",
      "args": {
        "requests": "fixtures/missing-export.csv",
        "dock": "fixtures/dock.json",
        "date": "2026-11-18"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
