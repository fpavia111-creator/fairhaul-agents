{
  "suite": "regulus-of-tariffs",
  "root": "..",
  "data_note": "Fictional contracts and history in ../fixtures. No model is called.",
  "cases": [
    {"id": "totals", "tool": "regulus_rerate", "args": {"history": "fixtures/history.csv", "contracts": "fixtures/contracts.json"}, "expect": {"equals": {"result.shipments": 7, "result.left_on_table": 281.51, "result.not_rateable": 1, "result.lanes_to_change": 2, "result.lane_savings": 281.51}}},
    {"id": "lane-ranking", "tool": "regulus_rerate", "args": {"history": "fixtures/history.csv", "contracts": "fixtures/contracts.json"}, "expect": {"equals": {"result.lanes.0.lane": "IL → TX", "result.lanes.0.best_carrier": "Prairie Express", "result.lanes.0.savings": 149.04, "result.lanes.1.best_carrier": "Coastal Line Haul"}}},
    {"id": "unpriced-accessorial-excluded", "tool": "regulus_rerate", "args": {"history": "fixtures/history.csv", "contracts": "fixtures/contracts.json"}, "expect": {"equals": {"result.items.4.best_carrier": "Coastal Line Haul"}, "contains": ["accessorial(s) not priced in this contract: residential"]}},
    {"id": "fuel-by-week", "tool": "regulus_rerate", "args": {"history": "fixtures/history.csv", "contracts": "fixtures/contracts.json"}, "expect": {"equals": {"result.items.0.quotes.0.fuel": 53.76, "result.items.2.quotes.0.fuel": 89.6}}},
    {"id": "change-is-production", "tool": "regulus_request_apply", "mode": "auto", "args": {"draft": "fixtures/README.md", "draft_sha256": "0"}, "expect": {"status": "needs_approval"}},
    {"id": "never-changes-routing", "tool": "tms_update_routing_guide", "mode": "auto", "args": {}, "expect": {"status": "blocked"}}
  ]
}
