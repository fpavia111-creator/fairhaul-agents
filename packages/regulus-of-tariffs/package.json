{
  "name": "regulus-of-tariffs",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/regulus-of-tariffs",
  "description": "Regulus of Tariffs: re-rates your shipment history under every carrier contract you hold (linehaul, minimums, discounts, fuel and accessorials), shows what each carrier would have cost, the cheapest carrier by lane and what you left on the table, and drafts routing guide changes. Never changes your routing guide.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "regulus-of-tariffs": "bin/regulus-of-tariffs.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/regulus-of-tariffs.js demo",
    "eval": "node bin/regulus-of-tariffs.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/regulus-of-tariffs"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/regulus-of-tariffs#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "rate-shopping",
    "routing-guide",
    "tariff",
    "what-if",
    "ltl"
  ]
}
