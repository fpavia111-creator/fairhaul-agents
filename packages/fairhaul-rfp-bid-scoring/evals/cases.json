{
  "suite": "fairhaul-rfp-bid-scoring",
  "root": "..",
  "data_note": "Fictional lanes, bids and rules in ../fixtures. No model is called.",
  "pii_none": "Reads rfp lanes, carrier bids: carriers, loads, amounts and dates; no column holds a person's name or contact details.",
  "cases": [
    {
      "id": "with-rules",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv",
        "rules": "fixtures/rules.json"
      },
      "expect": {
        "equals": {
          "result.awarded": 5,
          "result.no_bids": 1,
          "result.annual_cost": 458840,
          "result.baseline_cost": 477000,
          "result.savings": 18160,
          "result.incumbents_kept": 2,
          "result.outlier_bids": 1,
          "result.carriers.0.share_pct": 40
        }
      }
    },
    {
      "id": "no-rules",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv"
      },
      "expect": {
        "equals": {
          "result.results.0.awards.0.carrier": "Coastal Line Haul",
          "result.results.1.awards.0.carrier": "Ridgeline Freight"
        }
      }
    },
    {
      "id": "capacity-split",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv"
      },
      "expect": {
        "equals": {
          "result.results.2.awards.0.carrier": "Ridgeline Freight",
          "result.results.2.backup.carrier": "Summit Carriers"
        }
      }
    },
    {
      "id": "outlier-not-awarded",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv"
      },
      "expect": {
        "contains": [
          "far below the lane median"
        ],
        "not_contains": [
          "\"carrier\":\"Northgate Haulers\",\"loads\""
        ]
      }
    },
    {
      "id": "no-award-no-letter",
      "tool": "bids_draft_award",
      "mode": "auto",
      "auto_actions": [
        "bids_draft_award"
      ],
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv",
        "carrier": "Northgate Haulers"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "bids_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-loads-rates",
      "tool": "tms_load_rates",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-with-rules",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/intl/de/lanes.csv",
        "bids": "fixtures/intl/de/bids.csv",
        "rules": "fixtures/rules.json"
      },
      "expect": {
        "equals": {
          "result.awarded": 5,
          "result.no_bids": 1,
          "result.annual_cost": 458840,
          "result.baseline_cost": 477000,
          "result.savings": 18160,
          "result.incumbents_kept": 2,
          "result.outlier_bids": 1,
          "result.carriers.0.share_pct": 40
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"with-rules\"."
    },
    {
      "id": "intl-ja-with-rules",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/intl/ja/lanes.csv",
        "bids": "fixtures/intl/ja/bids.csv",
        "rules": "fixtures/rules.json"
      },
      "expect": {
        "equals": {
          "result.awarded": 5,
          "result.no_bids": 1,
          "result.annual_cost": 458840,
          "result.baseline_cost": 477000,
          "result.savings": 18160,
          "result.incumbents_kept": 2,
          "result.outlier_bids": 1,
          "result.carriers.0.share_pct": 40
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"with-rules\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "bids_write_report",
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv",
        "rules": "fixtures/rules.json",
        "out_dir": "fairhaul-out/evals/bids_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "6 lane(s), 380 annual loads: 5 awarded, 0 partly covered, 1 with no award",
          "Scenario cost 458840 against 477000 at incumbent rates (savings 18160)"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "bids_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "bids_award",
      "args": {
        "lanes": "../../outside.csv",
        "bids": "fixtures/bids.csv",
        "rules": "fixtures/rules.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv",
        "rules": "fixtures/rules.json"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.awarded": 5,
          "result.no_bids": 1,
          "result.annual_cost": 458840,
          "result.baseline_cost": 477000,
          "result.savings": 18160,
          "result.incumbents_kept": 2,
          "result.outlier_bids": 1,
          "result.carriers.0.share_pct": 40
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "bids_award",
      "args": {
        "bids": "fixtures/bids.csv",
        "rules": "fixtures/rules.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "lanes"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "bids_write_report",
      "args": {
        "lanes": "fixtures/lanes.csv",
        "bids": "fixtures/bids.csv",
        "rules": "fixtures/rules.json",
        "out_dir": "fairhaul-out/evals/bids_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "bids_award",
      "args": {
        "lanes": "fixtures/missing-export.csv",
        "bids": "fixtures/bids.csv",
        "rules": "fixtures/rules.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
