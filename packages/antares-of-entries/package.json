{
  "name": "antares-of-entries",
  "version": "0.1.0",
  "description": "Checks your customs broker's entry lines against your commercial invoices: value, quantity, origin, duty arithmetic and consistency of codes and rates across entries, with the days left to correct each entry. It gives no classification advice and files nothing.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "antares-of-entries": "bin/antares-of-entries.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/antares-of-entries.js demo",
    "eval": "node bin/antares-of-entries.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/antares-of-entries"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/antares-of-entries#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "customs",
    "entry-review",
    "import",
    "broker",
    "duty"
  ]
}
