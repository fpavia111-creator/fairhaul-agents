{
  "name": "alnilam-of-settlements",
  "version": "0.1.0",
  "description": "For freight brokers: settles every carrier payment against its rate confirmation, approved accessorials, quick-pay terms and notice of assignment, finds overpayments, double payments and payments to the wrong party, and drafts the next payment batch for a person to release.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "alnilam-of-settlements": "bin/alnilam-of-settlements.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/alnilam-of-settlements.js demo",
    "eval": "node bin/alnilam-of-settlements.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/alnilam-of-settlements"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/alnilam-of-settlements#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "broker",
    "carrier-pay",
    "settlements",
    "quick-pay",
    "factoring"
  ]
}
