{
  "suite": "fairhaul-returns-tracking",
  "root": "..",
  "data_note": "Fictional returns, receipts, credits and return freight in ../fixtures, as of 2026-11-16. No model is called.",
  "pii_none": "Reads return authorisations, returns received, credits issued, return freight billed: carriers, loads, amounts and dates; no column holds a person's name or contact details.",
  "cases": [
    {
      "id": "totals",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/rmas.csv",
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.rmas": 8,
          "result.findings": 8,
          "result.credits_owed": 250,
          "result.credit_at_risk": 119.6,
          "result.freight_disputable": 106.25
        }
      }
    },
    {
      "id": "every-check",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/rmas.csv",
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "label_unused",
          "received_not_credited",
          "credited_not_received",
          "short_received",
          "over_credited",
          "freight_billed_twice",
          "freight_without_rma"
        ]
      }
    },
    {
      "id": "costliest-reason",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/rmas.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.by_reason.0.reason": "customer changed mind"
        }
      }
    },
    {
      "id": "cancelled-skipped",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/rmas.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "not_contains": [
          "RMA-3008"
        ]
      }
    },
    {
      "id": "dispute",
      "tool": "returns_draft_carrier_dispute",
      "mode": "auto",
      "auto_actions": [
        "returns_draft_carrier_dispute"
      ],
      "args": {
        "rmas": "fixtures/rmas.csv",
        "charges": "fixtures/return-freight.csv",
        "carrier": "Parcel Co"
      },
      "expect": {
        "equals": {
          "result.amount": 106.25
        }
      }
    },
    {
      "id": "nothing-to-dispute",
      "tool": "returns_draft_carrier_dispute",
      "mode": "auto",
      "auto_actions": [
        "returns_draft_carrier_dispute"
      ],
      "args": {
        "rmas": "fixtures/rmas.csv",
        "charges": "fixtures/return-freight.csv",
        "carrier": "Other Carrier"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "returns_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-credits",
      "tool": "erp_issue_credit",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/intl/de/rmas.csv",
        "receipts": "fixtures/intl/de/receipts.csv",
        "credits": "fixtures/intl/de/credits.csv",
        "charges": "fixtures/intl/de/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.rmas": 8,
          "result.findings": 8,
          "result.credits_owed": 250,
          "result.credit_at_risk": 119.6,
          "result.freight_disputable": 106.25
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/intl/ja/rmas.csv",
        "receipts": "fixtures/intl/ja/receipts.csv",
        "credits": "fixtures/intl/ja/credits.csv",
        "charges": "fixtures/intl/ja/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.rmas": 8,
          "result.findings": 8,
          "result.credits_owed": 250,
          "result.credit_at_risk": 119.6,
          "result.freight_disputable": 106.25
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "returns_write_report",
      "args": {
        "rmas": "fixtures/rmas.csv",
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16",
        "out_dir": "fairhaul-out/evals/returns_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "8 return(s) worth 1081, return freight 253.35",
          "8 point(s): credits owed to customers 250, credit given without goods or over value 119.6, return freight to dispute 106.25"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "returns_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "returns_track",
      "args": {
        "rmas": "../../outside.csv",
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/rmas.csv",
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.rmas": 8,
          "result.findings": 8,
          "result.credits_owed": 250,
          "result.credit_at_risk": 119.6,
          "result.freight_disputable": 106.25
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "returns_track",
      "args": {
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "rmas"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "returns_write_report",
      "args": {
        "rmas": "fixtures/rmas.csv",
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16",
        "out_dir": "fairhaul-out/evals/returns_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-carrier-void-label",
      "tool": "carrier_void_label",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "returns_track",
      "args": {
        "rmas": "fixtures/missing-export.csv",
        "receipts": "fixtures/receipts.csv",
        "credits": "fixtures/credits.csv",
        "charges": "fixtures/return-freight.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
