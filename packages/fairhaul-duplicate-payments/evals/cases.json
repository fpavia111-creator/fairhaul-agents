{
  "suite": "fairhaul-duplicate-payments",
  "root": "..",
  "data_note": "Fictional AP payments in ../fixtures, as of 2026-11-16. No model is called.",
  "pii_none": "Reads ap payment history: carriers, loads, amounts and dates; no column holds a person's name or contact details.",
  "cases": [
    {
      "id": "totals",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/payments.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.groups": 6,
          "result.to_recover_high": 4950,
          "result.to_recover_medium": 185,
          "result.to_recover_low": 1200,
          "result.already_credited": 1
        }
      }
    },
    {
      "id": "every-rule",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/payments.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "invoice_number_variant",
          "two_vendor_records",
          "same_pro",
          "same_amount_and_date",
          "already_credited",
          "balance-due"
        ]
      }
    },
    {
      "id": "different-pros-are-not-duplicates",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/payments.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "not_contains": [
          "SC-1001"
        ]
      }
    },
    {
      "id": "wider-window",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/payments.csv",
        "as_of": "2026-11-16",
        "date_window_days": 0
      },
      "expect": {
        "equals": {
          "result.to_recover_low": 0
        }
      }
    },
    {
      "id": "only-credited-no-draft",
      "tool": "duplicates_draft_recovery",
      "mode": "auto",
      "auto_actions": [
        "duplicates_draft_recovery"
      ],
      "args": {
        "payments": "fixtures/payments.csv",
        "vendor": "Summit Carriers"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "duplicates_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-moves-money",
      "tool": "ap_void_payment",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/intl/de/payments.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.groups": 6,
          "result.to_recover_high": 4950,
          "result.to_recover_medium": 185,
          "result.to_recover_low": 1200,
          "result.already_credited": 1
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/intl/ja/payments.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.groups": 6,
          "result.to_recover_high": 4950,
          "result.to_recover_medium": 185,
          "result.to_recover_low": 1200,
          "result.already_credited": 1
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "duplicates_write_report",
      "args": {
        "payments": "fixtures/payments.csv",
        "as_of": "2026-11-16",
        "date_window_days": 0,
        "out_dir": "fairhaul-out/evals/duplicates_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "14 payment(s), 16245 paid: 5 possible duplicate group(s)",
          "To recover: 4950 high confidence, 185 medium, 0 low"
        ]
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "duplicates_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "equals": {
          "result.total": 0
        },
        "contains": [
          "0 fact(s) found (memory is empty)"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "duplicates_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "duplicates_search",
      "args": {
        "payments": "../../outside.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/payments.csv",
        "as_of": "2026-11-16"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.groups": 6,
          "result.to_recover_high": 4950,
          "result.to_recover_medium": 185,
          "result.to_recover_low": 1200,
          "result.already_credited": 1
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "duplicates_search",
      "args": {
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "payments"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "duplicates_write_report",
      "args": {
        "payments": "fixtures/payments.csv",
        "as_of": "2026-11-16",
        "date_window_days": 0,
        "out_dir": "fairhaul-out/evals/duplicates_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-erp-block-vendor",
      "tool": "erp_block_vendor",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "duplicates_search",
      "args": {
        "payments": "fixtures/missing-export.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
