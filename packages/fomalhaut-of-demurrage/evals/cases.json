{
  "suite": "fomalhaut-of-demurrage",
  "root": "..",
  "data_note": "Fictional containers, terms and charges in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {
      "id": "board",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.act_now": 2,
          "result.accruing": 2,
          "result.in_free_time": 1,
          "result.closed": 1,
          "result.no_terms": 1,
          "result.exposure_open": 1750,
          "result.over": 2,
          "result.disputable": 500
        }
      }
    },
    {
      "id": "tiers-and-closure",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.items.1.dem_charge_days": 6,
          "result.items.1.dem_cost": 1100,
          "result.items.2.det_cost": 200
        }
      }
    },
    {
      "id": "business-days",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.items.3.dem_lfd": "2026-11-16"
        },
        "contains": [
          "The line shows last free day 2026-11-13"
        ]
      }
    },
    {
      "id": "later-date",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-20"
      },
      "expect": {
        "equals": {
          "result.items.0.dem_charge_days": 4,
          "result.items.0.dem_cost": 800
        }
      }
    },
    {
      "id": "nothing-to-dispute",
      "tool": "fomalhaut_draft_dispute",
      "mode": "auto",
      "auto_actions": [
        "fomalhaut_draft_dispute"
      ],
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16",
        "line": "Harbor Star Line"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "fomalhaut_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-books",
      "tool": "terminal_book_appointment",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-board",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/intl/de/containers.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/intl/de/charges.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.act_now": 2,
          "result.accruing": 2,
          "result.in_free_time": 1,
          "result.closed": 1,
          "result.no_terms": 1,
          "result.exposure_open": 1750,
          "result.over": 2,
          "result.disputable": 500
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"board\"."
    },
    {
      "id": "intl-ja-board",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/intl/ja/containers.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/intl/ja/charges.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.act_now": 2,
          "result.accruing": 2,
          "result.in_free_time": 1,
          "result.closed": 1,
          "result.no_terms": 1,
          "result.exposure_open": 1750,
          "result.over": 2,
          "result.disputable": 500
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"board\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "fomalhaut_write_report",
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16",
        "out_dir": "lodestar-out/evals/fomalhaut_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 3
        },
        "contains": [
          "7 container(s): 2 to move now, 2 accruing charges, 1 in free time, 1 returned, 1 with no terms on file",
          "Open exposure 1750"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "fomalhaut_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "../../outside.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.act_now": 2,
          "result.accruing": 2,
          "result.in_free_time": 1,
          "result.closed": 1,
          "result.no_terms": 1,
          "result.exposure_open": 1750,
          "result.over": 2,
          "result.disputable": 500
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "fomalhaut_clocks",
      "args": {
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "containers"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "fomalhaut_write_report",
      "args": {
        "containers": "fixtures/containers.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16",
        "out_dir": "lodestar-out/evals/fomalhaut_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-ap-pay-invoice",
      "tool": "ap_pay_invoice",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "fomalhaut_clocks",
      "args": {
        "containers": "fixtures/missing-export.csv",
        "terms": "fixtures/terms.json",
        "charges": "fixtures/charges.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
