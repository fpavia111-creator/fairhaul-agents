{
  "name": "pollux-of-costing",
  "version": "0.1.0",
  "description": "Compares the standard freight built into item costs with what freight actually cost per unit, finds the SKUs and lanes where the standard is stale, and drafts new standards for a person to load.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pollux-of-costing": "bin/pollux-of-costing.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/pollux-of-costing.js demo",
    "eval": "node bin/pollux-of-costing.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/pollux-of-costing"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/pollux-of-costing#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "standard-cost",
    "landed-cost",
    "variance",
    "cost-accounting"
  ]
}
