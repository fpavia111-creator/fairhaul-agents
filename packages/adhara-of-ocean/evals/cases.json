{
  "suite": "adhara-of-ocean",
  "root": "..",
  "data_note": "Fictional ocean invoices and contracts in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "adhara_audit",
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.bills": 6,
          "result.billed": 28566,
          "result.disputable": 3355,
          "result.with_findings": 5
        }
      }
    },
    {
      "id": "every-finding",
      "tool": "adhara_audit",
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "contains": [
          "rate_over",
          "surcharge_out_of_window",
          "surcharge_included",
          "duplicate_charge",
          "surcharge_not_in_contract",
          "container_count",
          "contract_expired",
          "currency_mismatch"
        ]
      }
    },
    {
      "id": "alias-matches",
      "tool": "adhara_audit",
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.items.0.findings.length": 0
        }
      }
    },
    {
      "id": "extra-container",
      "tool": "adhara_audit",
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.items.3.disputable": 2100
        }
      }
    },
    {
      "id": "nothing-to-dispute",
      "tool": "adhara_draft_dispute",
      "mode": "auto",
      "auto_actions": [
        "adhara_draft_dispute"
      ],
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json",
        "carrier": "Northsea Container Line"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "adhara_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-pays",
      "tool": "ap_pay_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "adhara_audit",
      "args": {
        "invoices": "fixtures/intl/de/ocean-invoices.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.bills": 6,
          "result.billed": 28566,
          "result.disputable": 3355,
          "result.with_findings": 5
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "adhara_audit",
      "args": {
        "invoices": "fixtures/intl/ja/ocean-invoices.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.bills": 6,
          "result.billed": 28566,
          "result.disputable": 3355,
          "result.with_findings": 5
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "adhara_write_report",
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json",
        "out_dir": "lodestar-out/evals/adhara_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "6 bill(s) of lading, 28566 billed: 5 with findings, 3355 disputable",
          "container_count 1, contract_expired 1, currency_mismatch 1, duplicate_charge 1, rate_over 1, surcharge_included 1, surcharge_not_in_contract 1, surcharge_out_of_window 1"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "adhara_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "adhara_audit",
      "args": {
        "invoices": "../../outside.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "adhara_audit",
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.bills": 6,
          "result.billed": 28566,
          "result.disputable": 3355,
          "result.with_findings": 5
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "adhara_audit",
      "args": {
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "invoices"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "adhara_write_report",
      "args": {
        "invoices": "fixtures/ocean-invoices.csv",
        "contract": "fixtures/contract.json",
        "out_dir": "lodestar-out/evals/adhara_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    }
  ]
}
