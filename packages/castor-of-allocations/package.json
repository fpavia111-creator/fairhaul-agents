{
  "name": "castor-of-allocations",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/castor-of-allocations",
  "description": "Castor of Allocations: splits each freight bill across the orders, customers, SKUs and cost centers on the shipment by weight, volume, value, pallets or units, gives freight cost per unit by SKU and customer, and drafts the allocation journal for review. Never posts to your ledger.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "castor-of-allocations": "bin/castor-of-allocations.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/castor-of-allocations.js demo",
    "eval": "node bin/castor-of-allocations.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/castor-of-allocations"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/castor-of-allocations#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "freight-allocation",
    "cost-allocation",
    "landed-cost",
    "cost-to-serve",
    "journal"
  ]
}
