{
  "suite": "fairhaul-carrier-vetting",
  "root": "..",
  "data_note": "Fictional carriers and loads in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.high": 3,
          "result.medium": 1,
          "result.low": 1,
          "result.clean": 1,
          "result.loads_to_hold": 4,
          "result.loads_to_verify": 1
        }
      }
    },
    {
      "id": "shared-bank-and-phone",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.rows.0.carrier_id": "NORT",
          "result.rows.0.level": "high"
        },
        "contains": [
          "shared_bank",
          "shared_phone",
          "Bank account ending 7781"
        ]
      }
    },
    {
      "id": "load-contact-differs",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "contact_differs_on_load",
          "dispatch phone (913) 555-0123 differs"
        ]
      }
    },
    {
      "id": "unknown-carrier-held",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "carrier not in the master; vet before pickup"
        ]
      }
    },
    {
      "id": "inactive-not-scored",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "not_contains": [
          "Gulfport Transport (GULF)"
        ]
      }
    },
    {
      "id": "clean-carrier-no-draft",
      "tool": "vetting_draft_verification_request",
      "mode": "auto",
      "auto_actions": [
        "vetting_draft_verification_request"
      ],
      "args": {
        "carriers": "fixtures/carriers.csv",
        "carrier_id": "RIDG",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "draft",
      "tool": "vetting_draft_verification_request",
      "mode": "auto",
      "auto_actions": [
        "vetting_draft_verification_request"
      ],
      "args": {
        "carriers": "fixtures/carriers.csv",
        "carrier_id": "PRAI",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "verification_request",
          "Nothing was sent"
        ]
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "vetting_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-changes-bank",
      "tool": "ap_change_remit_to",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-blocks",
      "tool": "tms_block_carrier",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/intl/de/carriers.csv",
        "loads": "fixtures/intl/de/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.high": 3,
          "result.medium": 1,
          "result.low": 1,
          "result.clean": 1,
          "result.loads_to_hold": 4,
          "result.loads_to_verify": 1
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/intl/ja/carriers.csv",
        "loads": "fixtures/intl/ja/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.high": 3,
          "result.medium": 1,
          "result.low": 1,
          "result.clean": 1,
          "result.loads_to_hold": 4,
          "result.loads_to_verify": 1
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "vetting_write_report",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16",
        "out_dir": "fairhaul-out/evals/vetting_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "7 carrier(s) as of 2026-11-16: 3 high, 1 medium, 1 low on warning signs",
          "Of 6 booked load(s), 4 to hold until verified and 1 to verify before pickup"
        ]
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "vetting_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "equals": {
          "result.total": 0
        },
        "contains": [
          "0 fact(s) found (memory is empty)"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "vetting_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "vetting_vet",
      "args": {
        "carriers": "../../outside.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.high": 3,
          "result.medium": 1,
          "result.low": 1,
          "result.clean": 1,
          "result.loads_to_hold": 4,
          "result.loads_to_verify": 1
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "vetting_vet",
      "args": {
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "carriers"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "vetting_write_report",
      "args": {
        "carriers": "fixtures/carriers.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16",
        "out_dir": "fairhaul-out/evals/vetting_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "vetting_vet",
      "args": {
        "carriers": "fixtures/missing-export.csv",
        "loads": "fixtures/loads.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
