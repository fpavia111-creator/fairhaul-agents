  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "rigel-of-scorecards": "bin/rigel-of-scorecards.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/rigel-of-scorecards.js demo",
    "eval": "node bin/rigel-of-scorecards.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/rigel-of-scorecards"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/rigel-of-scorecards#readme",
  "bugs": {
