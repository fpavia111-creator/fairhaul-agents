{
  "name": "rigel-of-scorecards",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/rigel-of-scorecards",
  "description": "Rigel of Scorecards: scores each carrier on on-time pickup and delivery, tender acceptance, billing accuracy, claims, tracking and cost per mile from your own shipment history, with your weights, ranks them and drafts the quarterly review note. Never sends it.",
