{
  "name": "fairhaul-freight-emissions",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairhaul-freight-emissions",
  "description": "Estimates the greenhouse gas emissions of your shipments from weight, distance and mode, using emission factors you choose, with totals by mode, carrier, lane and customer, a data quality score and labelled mode-shift what-ifs. Every figure is an estimate; nothing is submitted anywhere.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairhaul-freight-emissions": "bin/fairhaul-freight-emissions.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairhaul-freight-emissions.js demo",
    "eval": "node bin/fairhaul-freight-emissions.js eval"
  },
  "dependencies": {
    "fairhaul-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairhaul-agents.git",
    "directory": "packages/fairhaul-freight-emissions"
  },
  "homepage": "https://github.com/fpavia111-creator/fairhaul-agents/tree/main/packages/fairhaul-freight-emissions#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairhaul-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "emissions",
    "carbon",
    "scope-3",
    "sustainability"
  ]
}
