{
  "name": "capella-of-claims",
  "version": "0.1.0",
  "description": "Capella of Claims: finds loss, shortage and damage on delivered shipments, works out the claim amount and the filing deadline from your terms, tracks open claims for carrier acknowledgement, payment and short payment, and drafts claim letters. Never files a claim itself.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "capella-of-claims": "bin/capella-of-claims.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/capella-of-claims.js demo",
    "eval": "node bin/capella-of-claims.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/capella-of-claims"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/capella-of-claims#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "cargo-claims",
    "osd",
    "loss-and-damage",
    "shortage"
  ]
}
