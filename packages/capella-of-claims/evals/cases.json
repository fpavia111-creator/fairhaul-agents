{
  "suite": "capella-of-claims",
  "root": "..",
  "data_note": "Fictional exceptions and claims in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {"id": "scan-totals", "tool": "capella_scan", "args": {"exceptions": "fixtures/exceptions.csv", "claims": "fixtures/claims-log.csv", "terms": "fixtures/terms.json", "as_of": "2026-11-16"}, "expect": {"equals": {"result.to_file": 4, "result.file_now": 1, "result.claimable": 8840, "result.expired": 1, "result.expired_value": 900, "result.filed": 1, "result.review": 1}}},
    {"id": "evidence-notes", "tool": "capella_scan", "args": {"exceptions": "fixtures/exceptions.csv", "terms": "fixtures/terms.json", "as_of": "2026-11-16"}, "expect": {"contains": ["signed clean", "10 day(s) after delivery", "capped from 1345", "below_minimum", "not_a_claim"]}},
    {"id": "default-terms", "tool": "capella_scan", "args": {"exceptions": "fixtures/exceptions.csv", "as_of": "2026-11-16"}, "expect": {"equals": {"result.to_file": 6, "result.terms.filing_window_days": 270}}},
    {"id": "export-columns", "tool": "capella_scan", "args": {"exceptions": "fixtures/exports/osd-log-style.csv", "terms": "fixtures/terms.json", "as_of": "2026-11-16"}, "expect": {"equals": {"result.claimable": 6840, "result.file_now": 1}}},
    {"id": "track-claims", "tool": "capella_track", "args": {"claims": "fixtures/claims-log.csv", "terms": "fixtures/terms.json", "as_of": "2026-11-16"}, "expect": {"equals": {"result.open": 4, "result.outstanding": 5380, "result.recovered": 3050, "result.needs_chasing": 4}, "contains": ["ack_overdue", "resolution_overdue", "short_paid", "declined"]}},
    {"id": "no-draft-for-expired", "tool": "capella_draft_claim", "mode": "auto", "auto_actions": ["capella_draft_claim"], "args": {"exceptions": "fixtures/exceptions.csv", "terms": "fixtures/terms.json", "as_of": "2026-11-16", "shipment_id": "L-2005"}, "expect": {"status": "error"}},
    {"id": "filing-stays-a-click-in-auto", "tool": "capella_request_file", "mode": "auto", "args": {"draft": "fixtures/README.md", "draft_sha256": "0"}, "expect": {"status": "needs_approval"}},
    {"id": "never-files", "tool": "carrier_portal_submit", "mode": "auto", "args": {}, "expect": {"status": "blocked"}},
    {"id": "never-offsets", "tool": "ap_offset_invoice", "mode": "auto", "args": {}, "expect": {"status": "blocked"}}
  ]
}
