{
  "suite": "capella-of-claims",
  "root": "..",
  "data_note": "Fictional exceptions and claims in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {
      "id": "scan-totals",
      "tool": "capella_scan",
      "args": {
        "exceptions": "fixtures/exceptions.csv",
        "claims": "fixtures/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.to_file": 4,
          "result.file_now": 1,
          "result.claimable": 8840,
          "result.expired": 1,
          "result.expired_value": 900,
          "result.filed": 1,
          "result.review": 1
        }
      }
    },
    {
      "id": "evidence-notes",
      "tool": "capella_scan",
      "args": {
        "exceptions": "fixtures/exceptions.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "signed clean",
          "10 day(s) after delivery",
          "capped from 1345",
          "below_minimum",
          "not_a_claim"
        ]
      }
    },
    {
      "id": "default-terms",
      "tool": "capella_scan",
      "args": {
        "exceptions": "fixtures/exceptions.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.to_file": 6,
          "result.terms.filing_window_days": 270
        }
      }
    },
    {
      "id": "export-columns",
      "tool": "capella_scan",
      "args": {
        "exceptions": "fixtures/exports/osd-log-style.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.claimable": 6840,
          "result.file_now": 1
        }
      }
    },
    {
      "id": "track-claims",
      "tool": "capella_track",
      "args": {
        "claims": "fixtures/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.open": 4,
          "result.outstanding": 5380,
          "result.recovered": 3050,
          "result.needs_chasing": 4
        },
        "contains": [
          "ack_overdue",
          "resolution_overdue",
          "short_paid",
          "declined"
        ]
      }
    },
    {
      "id": "no-draft-for-expired",
      "tool": "capella_draft_claim",
      "mode": "auto",
      "auto_actions": [
        "capella_draft_claim"
      ],
      "args": {
        "exceptions": "fixtures/exceptions.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16",
        "shipment_id": "L-2005"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "filing-stays-a-click-in-auto",
      "tool": "capella_request_file",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-files",
      "tool": "carrier_portal_submit",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-offsets",
      "tool": "ap_offset_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-scan-totals",
      "tool": "capella_scan",
      "args": {
        "exceptions": "fixtures/intl/de/exceptions.csv",
        "claims": "fixtures/intl/de/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.to_file": 4,
          "result.file_now": 1,
          "result.claimable": 8840,
          "result.expired": 1,
          "result.expired_value": 900,
          "result.filed": 1,
          "result.review": 1
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"scan-totals\"."
    },
    {
      "id": "intl-ja-scan-totals",
      "tool": "capella_scan",
      "args": {
        "exceptions": "fixtures/intl/ja/exceptions.csv",
        "claims": "fixtures/intl/ja/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.to_file": 4,
          "result.file_now": 1,
          "result.claimable": 8840,
          "result.expired": 1,
          "result.expired_value": 900,
          "result.filed": 1,
          "result.review": 1
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"scan-totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "capella_write_report",
      "args": {
        "exceptions": "fixtures/exceptions.csv",
        "claims": "fixtures/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16",
        "out_dir": "lodestar-out/evals/capella_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 3
        },
        "contains": [
          "As of 2026-11-16: 9 exception(s); 4 to file for 8840 (1 due within 30 days); 1 past the filing window (900); 1 already filed; 1 need more data"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "capella_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "capella_scan",
      "args": {
        "exceptions": "../../outside.csv",
        "claims": "fixtures/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "capella_scan",
      "args": {
        "exceptions": "fixtures/exceptions.csv",
        "claims": "fixtures/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.to_file": 4,
          "result.file_now": 1,
          "result.claimable": 8840,
          "result.expired": 1,
          "result.expired_value": 900,
          "result.filed": 1,
          "result.review": 1
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "capella_scan",
      "args": {
        "claims": "fixtures/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "exceptions"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "capella_write_report",
      "args": {
        "exceptions": "fixtures/exceptions.csv",
        "claims": "fixtures/claims-log.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-11-16",
        "out_dir": "lodestar-out/evals/capella_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    }
  ]
}
