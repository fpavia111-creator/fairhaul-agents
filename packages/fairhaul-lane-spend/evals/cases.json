{
  "suite": "fairhaul-lane-spend",
  "root": "..",
  "data_note": "Fictional shipments in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/shipments.csv"
      },
      "expect": {
        "equals": {
          "result.shipments": 12,
          "result.spend": 15990,
          "result.lanes_count": 3,
          "result.consolidation_groups": 1,
          "result.consolidation_saving": 526.25,
          "result.heavy_ltl": 1,
          "result.heavy_ltl_saving": 511
        }
      }
    },
    {
      "id": "top-lane",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/shipments.csv"
      },
      "expect": {
        "equals": {
          "result.lanes.0.lane": "IL 606 → TX 752",
          "result.lanes.0.share_pct": 44,
          "result.lanes.0.cost_per_cwt": 24.53
        }
      }
    },
    {
      "id": "lower-tl-rate",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/shipments.csv",
        "tl_rate_per_mile": 2.5
      },
      "expect": {
        "equals": {
          "result.consolidation_groups": 2
        }
      }
    },
    {
      "id": "state-lanes",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/shipments.csv",
        "window_days": 0
      },
      "expect": {
        "contains": [
          "IL 606 → GA 303"
        ]
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "lanes_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-holds-orders",
      "tool": "erp_hold_orders",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/intl/de/shipments.csv"
      },
      "expect": {
        "equals": {
          "result.shipments": 12,
          "result.spend": 15990,
          "result.lanes_count": 3,
          "result.consolidation_groups": 1,
          "result.consolidation_saving": 526.25,
          "result.heavy_ltl": 1,
          "result.heavy_ltl_saving": 511
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/intl/ja/shipments.csv"
      },
      "expect": {
        "equals": {
          "result.shipments": 12,
          "result.spend": 15990,
          "result.lanes_count": 3,
          "result.consolidation_groups": 1,
          "result.consolidation_saving": 526.25,
          "result.heavy_ltl": 1,
          "result.heavy_ltl_saving": 511
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "lanes_write_report",
      "args": {
        "shipments": "fixtures/shipments.csv",
        "tl_rate_per_mile": 2.5,
        "out_dir": "fairhaul-out/evals/lanes_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "12 shipment(s), 15990 spend on 3 lane(s); the top three carry 100% of spend",
          "2 group(s) of LTL could have shared a truck (about 955 less); 1 heavy LTL shipment(s) should be quoted as truckload (about 690 less)"
        ]
      }
    },
    {
      "id": "draft-consolidation-plan-waits-for-a-person",
      "tool": "lanes_draft_consolidation_plan",
      "args": {
        "shipments": "fixtures/shipments.csv",
        "tl_rate_per_mile": 2.5,
        "out_dir": "fairhaul-out/evals/lanes_draft_consolidation_plan"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-consolidation-plan-after-approval",
      "tool": "lanes_draft_consolidation_plan",
      "args": {
        "shipments": "fixtures/shipments.csv",
        "tl_rate_per_mile": 2.5,
        "out_dir": "fairhaul-out/evals/lanes_draft_consolidation_plan"
      },
      "approve": "Pat Example",
      "expect": {
        "status": "executed",
        "equals": {
          "result.amount": 1645,
          "result.open_markers": 3
        },
        "contains": [
          "consolidation plan consolidation drafted for 1645 with 3 open marker(s) ([TO CONFIRM shipping team or planner], [TO CONFIRM your name], [TO CONFIRM e.g",
          "hold orders for this lane to one ship day a week, or quote truckload above 10,000 lb])"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "lanes_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "../../outside.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/shipments.csv"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.shipments": 12,
          "result.spend": 15990,
          "result.lanes_count": 3,
          "result.consolidation_groups": 1,
          "result.consolidation_saving": 526.25,
          "result.heavy_ltl": 1,
          "result.heavy_ltl_saving": 511
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "lanes_analyse",
      "args": {},
      "expect": {
        "status": "error",
        "contains": [
          "shipments"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "lanes_draft_consolidation_plan",
      "args": {
        "shipments": "fixtures/shipments.csv",
        "tl_rate_per_mile": 2.5,
        "out_dir": "fairhaul-out/evals/lanes_draft_consolidation_plan"
      },
      "mode": "review",
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-tms-tender-load",
      "tool": "tms_tender_load",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "lanes_analyse",
      "args": {
        "shipments": "fixtures/missing-export.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
