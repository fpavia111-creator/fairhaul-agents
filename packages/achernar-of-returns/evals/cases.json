{
  "suite": "achernar-of-returns",
  "root": "..",
  "data_note": "Fictional returns, receipts, credits and return freight in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {"id": "totals", "tool": "achernar_track", "args": {"rmas": "fixtures/rmas.csv", "receipts": "fixtures/receipts.csv", "credits": "fixtures/credits.csv", "charges": "fixtures/return-freight.csv", "as_of": "2026-11-16"}, "expect": {"equals": {"result.rmas": 8, "result.findings": 8, "result.credits_owed": 250, "result.credit_at_risk": 119.6, "result.freight_disputable": 106.25}}},
    {"id": "every-check", "tool": "achernar_track", "args": {"rmas": "fixtures/rmas.csv", "receipts": "fixtures/receipts.csv", "credits": "fixtures/credits.csv", "charges": "fixtures/return-freight.csv", "as_of": "2026-11-16"}, "expect": {"contains": ["label_unused", "received_not_credited", "credited_not_received", "short_received", "over_credited", "freight_billed_twice", "freight_without_rma"]}},
    {"id": "costliest-reason", "tool": "achernar_track", "args": {"rmas": "fixtures/rmas.csv", "charges": "fixtures/return-freight.csv", "as_of": "2026-11-16"}, "expect": {"equals": {"result.by_reason.0.reason": "customer changed mind"}}},
    {"id": "cancelled-skipped", "tool": "achernar_track", "args": {"rmas": "fixtures/rmas.csv", "as_of": "2026-11-16"}, "expect": {"not_contains": ["RMA-3008"]}},
    {"id": "dispute", "tool": "achernar_draft_carrier_dispute", "mode": "auto", "auto_actions": ["achernar_draft_carrier_dispute"], "args": {"rmas": "fixtures/rmas.csv", "charges": "fixtures/return-freight.csv", "carrier": "Parcel Co"}, "expect": {"equals": {"result.amount": 106.25}}},
    {"id": "nothing-to-dispute", "tool": "achernar_draft_carrier_dispute", "mode": "auto", "auto_actions": ["achernar_draft_carrier_dispute"], "args": {"rmas": "fixtures/rmas.csv", "charges": "fixtures/return-freight.csv", "carrier": "Other Carrier"}, "expect": {"status": "error"}},
    {"id": "send-stays-a-click-in-auto", "tool": "achernar_request_send", "mode": "auto", "args": {"draft": "fixtures/README.md", "draft_sha256": "0"}, "expect": {"status": "needs_approval"}},
    {"id": "never-credits", "tool": "erp_issue_credit", "mode": "auto", "args": {}, "expect": {"status": "blocked"}}
  ]
}
