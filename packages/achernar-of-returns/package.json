    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "achernar-of-returns": "bin/achernar-of-returns.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
