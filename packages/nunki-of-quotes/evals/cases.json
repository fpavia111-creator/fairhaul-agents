{
  "suite": "nunki-of-quotes",
  "root": "..",
  "data_note": "Fictional loads and quotes in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {
      "id": "board",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.ready": 2,
          "result.check_price": 1,
          "result.requote": 1,
          "result.no_quotes": 1,
          "result.best_total": 6690
        }
      }
    },
    {
      "id": "linehaul-only-costs-more",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.items.0.best.carrier": "Ridgeline Freight",
          "result.items.0.quotes.1.all_in_cost": 2205
        }
      }
    },
    {
      "id": "missing-accessorial",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.items.2.best.carrier": "Prairie Express"
        },
        "contains": [
          "100 added for tarping"
        ]
      }
    },
    {
      "id": "without-allowances",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.items.2.best.carrier": "Summit Carriers"
        },
        "contains": [
          "ask whether tarping is included"
        ]
      }
    },
    {
      "id": "no-booking-on-expired",
      "tool": "nunki_draft_booking",
      "mode": "auto",
      "auto_actions": [
        "nunki_draft_booking"
      ],
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "as_of": "2026-11-16",
        "load_id": "Q-704"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "tender-stays-a-click-in-auto",
      "tool": "nunki_request_tender",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-tenders",
      "tool": "tms_tender_load",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-board",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/intl/de/loads.csv",
        "quotes": "fixtures/intl/de/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.ready": 2,
          "result.check_price": 1,
          "result.requote": 1,
          "result.no_quotes": 1,
          "result.best_total": 6690
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"board\"."
    },
    {
      "id": "intl-ja-board",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/intl/ja/loads.csv",
        "quotes": "fixtures/intl/ja/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.ready": 2,
          "result.check_price": 1,
          "result.requote": 1,
          "result.no_quotes": 1,
          "result.best_total": 6690
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"board\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "nunki_write_report",
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16",
        "out_dir": "lodestar-out/evals/nunki_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "5 load(s) as of 2026-11-16: 2 ready to book, 1 priced well above history, 1 need new quotes, 1 with none",
          "Best usable quotes total 6690 all-in (+590 against lane history)"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "nunki_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "nunki_compare",
      "args": {
        "loads": "../../outside.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.ready": 2,
          "result.check_price": 1,
          "result.requote": 1,
          "result.no_quotes": 1,
          "result.best_total": 6690
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "nunki_compare",
      "args": {
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "loads"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "nunki_write_report",
      "args": {
        "loads": "fixtures/loads.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16",
        "out_dir": "lodestar-out/evals/nunki_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "nunki_compare",
      "args": {
        "loads": "fixtures/missing-export.csv",
        "quotes": "fixtures/quotes.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
