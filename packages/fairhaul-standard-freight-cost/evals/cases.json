{
  "suite": "fairhaul-standard-freight-cost",
  "root": "..",
  "data_note": "Fictional items and August to October freight in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv"
      },
      "expect": {
        "equals": {
          "result.skus": 8,
          "result.actual_freight": 4270.44,
          "result.net_variance": 738.44,
          "result.under_costed": 798.44,
          "result.to_change": 4,
          "result.revaluation_estimate": 995.4
        }
      }
    },
    {
      "id": "rug-first",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv"
      },
      "expect": {
        "equals": {
          "result.rows.0.sku": "FLOOR-RUG",
          "result.rows.0.status": "standard_too_low",
          "result.rows.0.proposed_standard": 31.19
        }
      }
    },
    {
      "id": "every-status",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv"
      },
      "expect": {
        "contains": [
          "standard_too_high",
          "no_standard",
          "thin_data",
          "no_shipments"
        ]
      }
    },
    {
      "id": "looser-threshold",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv",
        "threshold_pct": 40
      },
      "expect": {
        "equals": {
          "result.standard_too_low": 0,
          "result.standard_too_high": 0,
          "result.to_change": 1
        }
      }
    },
    {
      "id": "draft-has-table",
      "tool": "costing_draft_standard_update",
      "mode": "auto",
      "auto_actions": [
        "costing_draft_standard_update"
      ],
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv",
        "to": "Priya Nair",
        "system": "the ERP"
      },
      "expect": {
        "contains": [
          "standard_update",
          "Nothing was sent"
        ]
      }
    },
    {
      "id": "apply-stays-a-click-in-auto",
      "tool": "costing_request_apply",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-changes-costs",
      "tool": "erp_update_item_cost",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-revalues",
      "tool": "erp_revalue_inventory",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/intl/de/items.csv",
        "actuals": "fixtures/intl/de/actual-freight.csv"
      },
      "expect": {
        "equals": {
          "result.skus": 8,
          "result.actual_freight": 4270.44,
          "result.net_variance": 738.44,
          "result.under_costed": 798.44,
          "result.to_change": 4,
          "result.revaluation_estimate": 995.4
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/intl/ja/items.csv",
        "actuals": "fixtures/intl/ja/actual-freight.csv"
      },
      "expect": {
        "equals": {
          "result.skus": 8,
          "result.actual_freight": 4270.44,
          "result.net_variance": 738.44,
          "result.under_costed": 798.44,
          "result.to_change": 4,
          "result.revaluation_estimate": 995.4
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "costing_write_report",
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv",
        "threshold_pct": 40,
        "out_dir": "lodestar-out/evals/costing_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "8 SKU(s), 1353 units: actual freight 4270.44 vs 3437 at standard (net +738.44)",
          "0 standard(s) too low, 0 too high, 1 with no standard; 1 to change, inventory revaluation about 0"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "costing_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "costing_compare",
      "args": {
        "items": "../../outside.csv",
        "actuals": "fixtures/actual-freight.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.skus": 8,
          "result.actual_freight": 4270.44,
          "result.net_variance": 738.44,
          "result.under_costed": 798.44,
          "result.to_change": 4,
          "result.revaluation_estimate": 995.4
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "costing_compare",
      "args": {
        "actuals": "fixtures/actual-freight.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "items"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "costing_write_report",
      "args": {
        "items": "fixtures/items.csv",
        "actuals": "fixtures/actual-freight.csv",
        "threshold_pct": 40,
        "out_dir": "lodestar-out/evals/costing_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "costing_compare",
      "args": {
        "items": "fixtures/missing-export.csv",
        "actuals": "fixtures/actual-freight.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
