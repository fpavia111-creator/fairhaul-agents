{
  "name": "hadar-of-docks",
  "version": "0.1.0",
  "description": "Plans a day of dock appointments across your doors, crews and hours, lists requests that do not fit, and reviews past appointments for no-shows, late arrivals, waits and how long each kind of load really takes. It never books or confirms an appointment.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "hadar-of-docks": "bin/hadar-of-docks.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/hadar-of-docks.js demo",
    "eval": "node bin/hadar-of-docks.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/hadar-of-docks"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/hadar-of-docks#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "dock-scheduling",
    "appointments",
    "warehouse",
    "receiving",
    "yard"
  ]
}
