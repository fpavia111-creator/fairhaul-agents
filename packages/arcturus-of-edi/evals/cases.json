{
  "suite": "arcturus-of-edi",
  "root": "..",
  "data_note": "Fictional X12 004010 files in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "clean-files-read",
      "tool": "arcturus_inspect",
      "args": {
        "files": [
          "fixtures/tenders-204.edi",
          "fixtures/responses-990.edi",
          "fixtures/status-214.edi",
          "fixtures/invoices-210.edi",
          "fixtures/ack-997.edi"
        ]
      },
      "expect": {
        "contains": [
          "13 transaction(s) read; 0 file(s) with problems"
        ]
      }
    },
    {
      "id": "broken-counts-found",
      "tool": "arcturus_inspect",
      "args": {
        "files": [
          "fixtures/broken-210.edi"
        ]
      },
      "expect": {
        "contains": [
          "se_count",
          "ge_count"
        ]
      }
    },
    {
      "id": "not-edi-said-plainly",
      "tool": "arcturus_inspect",
      "args": {
        "files": [
          "fixtures/not-edi.txt"
        ]
      },
      "expect": {
        "contains": [
          "not an X12 file"
        ]
      }
    },
    {
      "id": "reconcile-findings",
      "tool": "arcturus_reconcile",
      "args": {
        "files": [
          "fixtures/tenders-204.edi",
          "fixtures/responses-990.edi",
          "fixtures/status-214.edi",
          "fixtures/invoices-210.edi",
          "fixtures/ack-997.edi"
        ]
      },
      "expect": {
        "equals": {
          "result.by_finding.invoice_over_tender": 2,
          "result.by_finding.invoice_without_tender": 1,
          "result.by_finding.invoiced_without_delivery_status": 1,
          "result.by_finding.rejected_by_partner": 1
        }
      }
    },
    {
      "id": "declined-everywhere",
      "tool": "arcturus_reconcile",
      "args": {
        "files": [
          "fixtures/tenders-204.edi",
          "fixtures/invoices-210.edi"
        ]
      },
      "expect": {
        "contains": [
          "tender_no_response"
        ]
      }
    },
    {
      "id": "invoice-on-cancelled-tender-held",
      "tool": "arcturus_reconcile",
      "args": {
        "files": [
          "fixtures/tenders-204.edi",
          "fixtures/cancel-204.edi",
          "fixtures/invoices-210.edi"
        ]
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.invoices": 3
        },
        "contains": [
          "invoice_on_cancelled_tender",
          "Invoice INV-7101 is for SH-1001, whose tender was cancelled"
        ]
      }
    },
    {
      "id": "acceptance-rates",
      "tool": "arcturus_tender_stats",
      "args": {
        "files": [
          "fixtures/responses-990.edi"
        ]
      },
      "expect": {
        "equals": {
          "result.carriers.0.scac": "EXLT",
          "result.carriers.0.acceptance_pct": 67
        }
      }
    },
    {
      "id": "never-transmits",
      "tool": "edi_transmit",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-uploads",
      "tool": "van_upload",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "convert-writes-files",
      "tool": "arcturus_convert",
      "args": {
        "files": [
          "fixtures/tenders-204.edi",
          "fixtures/responses-990.edi",
          "fixtures/status-214.edi",
          "fixtures/invoices-210.edi",
          "fixtures/ack-997.edi"
        ],
        "out_dir": "lodestar-out/evals/arcturus_convert"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 8
        },
        "contains": [
          "6 CSV file(s) and the reconciliation written"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "arcturus_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "arcturus_inspect",
      "args": {
        "files": [
          "../../outside.csv",
          "fixtures/responses-990.edi",
          "fixtures/status-214.edi",
          "fixtures/invoices-210.edi",
          "fixtures/ack-997.edi"
        ]
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "arcturus_inspect",
      "args": {
        "files": [
          "fixtures/tenders-204.edi",
          "fixtures/responses-990.edi",
          "fixtures/status-214.edi",
          "fixtures/invoices-210.edi",
          "fixtures/ack-997.edi"
        ]
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "arcturus_inspect",
      "args": {},
      "expect": {
        "status": "error",
        "contains": [
          "files"
        ]
      }
    }
  ]
}
