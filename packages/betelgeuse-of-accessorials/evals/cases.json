{
  "suite": "betelgeuse-of-accessorials",
  "root": "..",
  "data_note": "Fictional invoices, shipments and contract in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.accessorial_total": 890,
          "result.freight_total": 4750,
          "result.accessorial_share_pct": 18.7,
          "result.unordered": 6,
          "result.unordered_amount": 380,
          "result.over_amount": 10
        }
      }
    },
    {
      "id": "repeats",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv"
      },
      "expect": {
        "equals": {
          "result.fixes.0.location": "Austin TX 78701",
          "result.fixes.0.code": "residential",
          "result.fixes.0.times": 3
        },
        "contains": [
          "Mark the address residential",
          "liftgate required",
          "appointment required",
          "Vega of Detention"
        ]
      }
    },
    {
      "id": "repeat-threshold",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv",
        "repeat_at": 3
      },
      "expect": {
        "equals": {
          "result.fixes.1.code": "liftgate"
        }
      }
    },
    {
      "id": "without-shipments",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "fixtures/invoices.csv"
      },
      "expect": {
        "equals": {
          "result.unordered": 0,
          "result.not_matched": 12
        }
      }
    },
    {
      "id": "change-list-is-production",
      "tool": "betelgeuse_request_apply",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-edits-tms",
      "tool": "tms_update_address",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-pays",
      "tool": "ap_pay_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "fixtures/intl/de/invoices.csv",
        "shipments": "fixtures/intl/de/shipments.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.accessorial_total": 890,
          "result.freight_total": 4750,
          "result.accessorial_share_pct": 18.7,
          "result.unordered": 6,
          "result.unordered_amount": 380,
          "result.over_amount": 10
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "fixtures/intl/ja/invoices.csv",
        "shipments": "fixtures/intl/ja/shipments.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "equals": {
          "result.accessorial_total": 890,
          "result.freight_total": 4750,
          "result.accessorial_share_pct": 18.7,
          "result.unordered": 6,
          "result.unordered_amount": 380,
          "result.over_amount": 10
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "betelgeuse_write_report",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json",
        "out_dir": "lodestar-out/evals/betelgeuse_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "9 invoice(s): accessorials 890 of 4750 freight (18.7%)",
          "6 charge(s) billed but not ordered (380); 1 above contract (10); 4 repeat(s) to fix at the source"
        ]
      }
    },
    {
      "id": "draft-address-update-waits-for-a-person",
      "tool": "betelgeuse_draft_address_update",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json",
        "out_dir": "lodestar-out/evals/betelgeuse_draft_address_update"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-address-update-after-approval",
      "tool": "betelgeuse_draft_address_update",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json",
        "out_dir": "lodestar-out/evals/betelgeuse_draft_address_update"
      },
      "approve": "Pat Example",
      "expect": {
        "status": "executed",
        "equals": {
          "result.amount": 680,
          "result.open_markers": 2,
          "result.changes": 4
        },
        "contains": [
          "address update address-book drafted for 680 with 2 open marker(s) ([TO CONFIRM who maintains the address book], [TO CONFIRM your name])"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "betelgeuse_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "../../outside.csv",
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "betelgeuse_analyse",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.accessorial_total": 890,
          "result.freight_total": 4750,
          "result.accessorial_share_pct": 18.7,
          "result.unordered": 6,
          "result.unordered_amount": 380,
          "result.over_amount": 10
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "betelgeuse_analyse",
      "args": {
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "invoices"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "betelgeuse_draft_address_update",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "shipments": "fixtures/shipments.csv",
        "contract": "fixtures/contract.json",
        "out_dir": "lodestar-out/evals/betelgeuse_draft_address_update"
      },
      "mode": "review",
      "expect": {
        "status": "blocked"
      }
    }
  ]
}
