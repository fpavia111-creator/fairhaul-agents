    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairhaul-air-freight-audit": "bin/fairhaul-air-freight-audit.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairhaul-air-freight-audit.js demo",
    "eval": "node bin/fairhaul-air-freight-audit.js eval"
  },
  "dependencies": {
    "fairhaul-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairhaul-agents.git",
    "directory": "packages/fairhaul-air-freight-audit"
  },
  "homepage": "https://github.com/fpavia111-creator/fairhaul-agents/tree/main/packages/fairhaul-air-freight-audit#readme",
