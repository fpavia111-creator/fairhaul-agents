{
  "name": "mira-of-tracking",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/mira-of-tracking",
  "description": "Mira of Tracking: reads your open loads and their tracking events, finds loads with stale or no tracking, missed pickups and ETAs that run past the delivery appointment, ranks carriers on tracking compliance and drafts the delay notice to your customer. Never messages anyone itself.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "mira-of-tracking": "bin/mira-of-tracking.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/mira-of-tracking.js demo",
    "eval": "node bin/mira-of-tracking.js eval"
  },
  "dependencies": {
    "lodestar-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/lodestar-agents.git",
    "directory": "packages/mira-of-tracking"
  },
  "homepage": "https://github.com/fpavia111-creator/lodestar-agents/tree/main/packages/mira-of-tracking#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/lodestar-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "freight",
    "logistics",
    "freight-audit",
    "lodestar",
    "shipment-visibility",
    "tracking",
    "eta",
    "late-shipments",
    "exceptions"
  ]
}
