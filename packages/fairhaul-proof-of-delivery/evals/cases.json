{
  "suite": "fairhaul-proof-of-delivery",
  "root": "..",
  "data_note": "Fictional loads and PODs in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.ok": 3,
          "result.chase": 2,
          "result.waiting": 1,
          "result.claim_review": 2,
          "result.fix": 2,
          "result.invoices_to_hold": 5,
          "result.held_amount": 7830
        }
      }
    },
    {
      "id": "every-issue",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "missing_pod",
          "unsigned",
          "date_mismatch",
          "short",
          "exception_noted",
          "requires a POD"
        ]
      }
    },
    {
      "id": "carrier-rates",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.carriers.0.carrier": "Prairie Express",
          "result.carriers.0.pod_pct": 50,
          "result.carriers.1.avg_days_to_pod": 6.5
        }
      }
    },
    {
      "id": "shorter-wait",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16",
        "chase_after_days": 0
      },
      "expect": {
        "equals": {
          "result.chase": 3,
          "result.waiting": 0
        }
      }
    },
    {
      "id": "nothing-to-request",
      "tool": "pod_draft_pod_request",
      "mode": "auto",
      "auto_actions": [
        "pod_draft_pod_request"
      ],
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16",
        "carrier": "Summit Carriers"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "send-stays-a-click-in-auto",
      "tool": "pod_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/README.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "never-holds-in-ap",
      "tool": "ap_hold_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/intl/de/loads.csv",
        "pods": "fixtures/intl/de/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.ok": 3,
          "result.chase": 2,
          "result.waiting": 1,
          "result.claim_review": 2,
          "result.fix": 2,
          "result.invoices_to_hold": 5,
          "result.held_amount": 7830
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/intl/ja/loads.csv",
        "pods": "fixtures/intl/ja/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.ok": 3,
          "result.chase": 2,
          "result.waiting": 1,
          "result.claim_review": 2,
          "result.fix": 2,
          "result.invoices_to_hold": 5,
          "result.held_amount": 7830
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    },
    {
      "id": "write-report-writes-files",
      "tool": "pod_write_report",
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16",
        "chase_after_days": 0,
        "out_dir": "lodestar-out/evals/pod_write_report"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "10 load(s) as of 2026-11-16: 3 clean POD(s), 3 to chase, 0 still within the wait period, 2 with shortage or damage noted, 2 to fix",
          "5 invoice(s) to hold for review (7830)"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "pod_pay_all_invoices_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "pod_match",
      "args": {
        "loads": "../../outside.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16"
      },
      "mode": "review",
      "expect": {
        "status": "executed",
        "equals": {
          "result.ok": 3,
          "result.chase": 2,
          "result.waiting": 1,
          "result.claim_review": 2,
          "result.fix": 2,
          "result.invoices_to_hold": 5,
          "result.held_amount": 7830
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "pod_match",
      "args": {
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "loads"
        ]
      }
    },
    {
      "id": "review-mode-still-reports",
      "tool": "pod_write_report",
      "args": {
        "loads": "fixtures/loads.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16",
        "chase_after_days": 0,
        "out_dir": "lodestar-out/evals/pod_write_report"
      },
      "mode": "review",
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "refuses-ap-release-payment",
      "tool": "ap_release_payment",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-email-send",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "pod_match",
      "args": {
        "loads": "fixtures/missing-export.csv",
        "pods": "fixtures/pods.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
